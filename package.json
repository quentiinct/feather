{
  "name": "feather",
  "productName": "Feather",
  "version": "0.1.0",
  "description": "Dictée vocale locale et instantanée pour Windows — parlez, Feather écrit dans n'importe quelle application.",
  "main": "src/main/index.js",
  "author": "Quentin Courtade",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "setup": "node scripts/setup-whisper.js",
    "postinstall": "node scripts/make-icons.js",
    "build": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "pack": "electron-builder --dir",
    "icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.quentincourtade.feather",
    "productName": "Feather",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Feather"
    },
    "asarUnpack": [
      "resources/inject.ps1"
    ],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "quentiinct",
        "repo": "feather"
      }
    ]
  }
}
